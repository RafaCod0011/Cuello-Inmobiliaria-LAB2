@model Cuello_Inmobiliaria_LAB2.Models.Inquilino

@{
    ViewData["Title"] = "Detalles del Inquilino";
}

<section class="details-page">
    <div class="details-card">
        <header class="edit-card-header">
            <div class="edit-icon" aria-hidden="true"><i class="fa-solid fa-user"></i></div>
            <div>
                <p class="edit-eyebrow">Gestion de inquilinos</p>
                <h1>Detalles del inquilino</h1>
                <p class="edit-description">Consulte la información personal y de contacto del inquilino.</p>
            </div>
        </header>

        <div class="row details-layout">
            <div class="col-md-12">
                <dl class="details-list">
                    <div class="details-row">
                        <dt>
                            @Html.DisplayNameFor(model => model.IdInquilino)
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.IdInquilino)
                        </dd>
                    </div>

                    <div class="details-row">
                        <dt>
                            @Html.DisplayNameFor(model => model.Nombre)
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.Nombre)
                        </dd>
                    </div>

                    <div class="details-row">
                        <dt>
                            @Html.DisplayNameFor(model => model.Apellido)
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.Apellido)
                        </dd>
                    </div>

                    <div class="details-row">
                        <dt>
                            @Html.DisplayNameFor(model => model.Dni)
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.Dni)
                        </dd>
                    </div>

                    <div class="details-row">
                        <dt>
                            @Html.DisplayNameFor(model => model.Telefono)
                        </dt>
                        <dd>
                            @(string.IsNullOrWhiteSpace(Model.Telefono) ? "No registrado" : Model.Telefono)
                        </dd>
                    </div>

                    <div class="details-row">
                        <dt>
                            @Html.DisplayNameFor(model => model.Email)
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.Email)
                        </dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="details-actions">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left me-2" aria-hidden="true"></i><span>Volver a la lista</span>
            </a>
            <a asp-action="Edit" asp-route-id="@Model.IdInquilino" class="btn btn-primary">
                <i class="fa-solid fa-pen me-2" aria-hidden="true"></i><span>Editar</span>
            </a>
        </div>
    </div>
</section>
