@model Cuello_Inmobiliaria_LAB2.Models.Reserva

@{
    ViewData["Title"] = "Editar Reserva";

    var yaComenzo = Model.FechaInicio <= DateTime.Today;
    var estaFinalizada = Model.FechaFin < DateTime.Today;
    var estaTerminada = Model.EstaTerminada;

    var extensiones = (IList<Cuello_Inmobiliaria_LAB2.Models.Reserva>)ViewBag.Extensiones
                        ?? new List<Cuello_Inmobiliaria_LAB2.Models.Reserva>();
    var tieneExtensiones = extensiones.Any();

    // Bloquea edición
    var bloqueado = yaComenzo || estaFinalizada || estaTerminada || tieneExtensiones;

    // Tiene pagos no anulados
    var tienePagos = ((IList<Cuello_Inmobiliaria_LAB2.Models.Pago>)ViewBag.Pagos
                        ?? new List<Cuello_Inmobiliaria_LAB2.Models.Pago>())
                        .Any(p => !p.Anulado);

    var puedeEditar = !bloqueado;
}

<section class="edit-page">
    <div class="edit-card reservation-card">
        <header class="edit-card-header">
            <div class="edit-icon" aria-hidden="true"><i class="fa-solid fa-calendar-check"></i></div>
            <div>
                <p class="edit-eyebrow">Gestion de reservas</p>
                <h1>Editar reserva</h1>
                <p class="edit-description">Actualice los datos de la reserva seleccionada.</p>
            </div>
        </header>

        @if (tieneExtensiones)
        {
            <div class="alert alert-warning m-3">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                Esta reserva tiene <strong>@extensiones.Count extensión(es) asociada(s)</strong>.
                No se puede editar mientras existan.
                <hr />
                <p class="mb-2"><strong>Extensiones:</strong></p>
                <ul class="list-unstyled mb-2">
                    @foreach (var ext in extensiones)
                    {
                        <li class="mb-1">
                            <a asp-action="Ver" asp-route-id="@ext.IdReserva" class="btn btn-sm btn-outline-primary">
                                <i class="fa-solid fa-calendar-plus me-1"></i>
                                Reserva #@ext.IdReserva
                                (@ext.FechaInicio.ToString("dd/MM/yyyy") - @ext.FechaFin.ToString("dd/MM/yyyy"))
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
        else if (estaTerminada)
        {
            <div class="alert alert-warning m-3">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                Esta reserva fue <strong>terminada anticipadamente</strong>. No se puede editar.
            </div>
        }
        else if (estaFinalizada)
        {
            <div class="alert alert-warning m-3">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                Esta reserva ya <strong>finalizó</strong>. No se puede editar.
            </div>
        }
        else if (yaComenzo)
        {
            <div class="alert alert-info m-3">
                <i class="fa-solid fa-circle-info me-2"></i>
                Esta reserva está <strong>vigente</strong>. No se pueden modificar fechas, inmueble ni inquilino.
            </div>
        }

        @if (tienePagos && !bloqueado)
        {
            <div class="alert alert-info m-3">
                <i class="fa-solid fa-circle-info me-2"></i>
                Esta reserva ya tiene <strong>pagos registrados</strong>. No se puede modificar el monto diario.
            </div>
        }

        <form asp-action="Edit" asp-route-id="@Model.IdReserva" class="edit-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdReserva" />

            <div class="edit-fields reservation-fields">
                <div class="form-group reservation-wide-field">
                    <label asp-for="IdInmueble" class="control-label"></label>
                    <select asp-for="IdInmueble" class="form-control" id="IdInmueble" disabled="@bloqueado">
                        @if (ViewBag.InmuebleId != null)
                        {
                            <option value="@ViewBag.InmuebleId" selected>@ViewBag.InmuebleSeleccionado</option>
                        }
                    </select>
                    <span asp-validation-for="IdInmueble" class="text-danger"></span>
                </div>

                <div class="form-group reservation-wide-field">
                    <label asp-for="IdInquilino" class="control-label"></label>
                    <select asp-for="IdInquilino" class="form-control" id="IdInquilino" disabled="@bloqueado">
                        @if (ViewBag.InquilinoId != null)
                        {
                            <option value="@ViewBag.InquilinoId" selected>@ViewBag.InquilinoSeleccionado</option>
                        }
                    </select>
                    <span asp-validation-for="IdInquilino" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="FechaInicio" class="control-label"></label>
                    <input asp-for="FechaInicio" class="form-control" type="date" disabled="@bloqueado" />
                    <span asp-validation-for="FechaInicio" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="FechaFin" class="control-label"></label>
                    <input asp-for="FechaFin" class="form-control" type="date" disabled="@bloqueado" />
                    <span asp-validation-for="FechaFin" class="text-danger"></span>
                </div>

                <div class="form-group reservation-wide-field">
                    <label asp-for="MontoDiario" class="control-label"></label>

                    @if (bloqueado)
                    {
                        <input asp-for="MontoDiario" class="form-control" disabled />
                    }
                    else if (tienePagos)
                    {
                        <input id="MontoDiario" class="form-control"
                               value="@Model.MontoDiario.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                               disabled />
                        <input type="hidden" asp-for="MontoDiario" />
                        <small class="text-muted">No se puede modificar porque ya tiene pagos registrados.</small>
                    }
                    else
                    {
                        <input asp-for="MontoDiario" class="form-control" id="MontoDiario" />
                    }

                    <span asp-validation-for="MontoDiario" class="text-danger"></span>
                </div>
            </div>

            <div class="edit-actions">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left me-2" aria-hidden="true"></i><span>Volver a la lista</span>
                </a>
                @if (puedeEditar)
                {
                    <button type="submit" class="btn btn-success">
                        <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Guardar cambios
                    </button>
                }
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            @if (!bloqueado)
                {
                    <text>
                            $('#IdInmueble').select2({
                                language: "es",
                            theme: 'bootstrap-5',
                            placeholder: "Buscar inmueble por dirección...",
                            minimumInputLength: 2,
                            allowClear: true,
                            ajax: {
                                delay: 250,
                            dataType: "json",
                            cache: true,
                            url: function (params) {
                                let q = params.term ? encodeURIComponent(params.term) : "";
                            return '@Url.Action("Buscar", "Inmueble")?term=' + q;
                                        },
                            processResults: function (data) {
                                            return {results: data };
                                        }
                                    }
                                }).on('select2:select', function (e) {
                                @if (!tienePagos)
                                {
                                    <text>
                                            var precio = e.params.data.precio;
                                            if (precio) {
                                                $('#MontoDiario').val(precio);
                                                    }
                                    </text>
                                    }
                                });

                            $('#IdInquilino').select2({
                                language: "es",
                            theme: 'bootstrap-5',
                            placeholder: "Buscar inquilino por nombre, apellido o DNI...",
                            minimumInputLength: 2,
                            allowClear: true,
                            ajax: {
                                delay: 250,
                            dataType: "json",
                            cache: true,
                            url: function (params) {
                                let q = params.term ? encodeURIComponent(params.term) : "";
                            return '@Url.Action("Buscar", "Inquilino")?term=' + q;
                                        },
                            processResults: function (data) {
                                            return {results: data };
                                        }
                                    }
                                });
                    </text>
            }
            });
    </script>
}