@model Cuello_Inmobiliaria_LAB2.Models.Reserva

@{
    ViewData["Title"] = "Editar Reserva";
    var inmuebles = (IList<Cuello_Inmobiliaria_LAB2.Models.Inmueble>)ViewBag.Inmuebles;
    var inquilinos = (IList<Cuello_Inmobiliaria_LAB2.Models.Inquilino>)ViewBag.Inquilinos;
}

<section class="edit-page">
    <div class="edit-card reservation-card">
        <header class="edit-card-header">
            <div class="edit-icon" aria-hidden="true"><i class="fa-solid fa-calendar-check"></i></div>
            <div>
                <p class="edit-eyebrow">Gestion de reservas</p>
                <h1>Editar reserva</h1>
                <p class="edit-description">Actualice los datos de la reserva seleccionada.</p>
            </div>
        </header>

        <p class="text-danger">Solo para la segunda entrega. Para el sistema final, se debe implementar la funcionalidad
            de
            renovacion/extension, asi la reserva original queda como registro historico.</p>
            <form asp-action="Edit" asp-route-id="@Model.IdReserva" class="edit-form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="IdReserva" />
                <div class="edit-fields reservation-fields">
                    <div class="form-group reservation-wide-field">
                        <label asp-for="IdInmueble" class="control-label"></label>
                        <select asp-for="IdInmueble" class="form-control">
                            <option value="">Seleccionar inmueble</option>
                            @foreach (var item in inmuebles)
                            {
                                <option value="@item.IdInmueble">@item.Direccion</option>
                            }
                        </select>
                        <span asp-validation-for="IdInmueble" class="text-danger"></span>
                    </div>
                    <div class="form-group reservation-wide-field">
                        <label asp-for="IdInquilino" class="control-label"></label>
                        <select asp-for="IdInquilino" class="form-control select2">
                            @if (ViewBag.InquilinoId != null)
                            {
                                <option value="@ViewBag.InquilinoId" selected>@ViewBag.InquilinoSeleccionado</option>
                            }
                        </select>
                        <span asp-validation-for="IdInquilino" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FechaInicio" class="control-label"></label>
                        <input asp-for="FechaInicio" class="form-control" type="date" />
                        <span asp-validation-for="FechaInicio" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FechaFin" class="control-label"></label>
                        <input asp-for="FechaFin" class="form-control" type="date" />
                        <span asp-validation-for="FechaFin" class="text-danger"></span>
                    </div>
                    <div class="form-group reservation-wide-field">
                        <label asp-for="MontoDiario" class="control-label"></label>
                        <input asp-for="MontoDiario" class="form-control" />
                        <span asp-validation-for="MontoDiario" class="text-danger"></span>
                    </div>
                </div>
                <div class="edit-actions">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left me-2" aria-hidden="true"></i><span>Volver a la lista</span>
                    </a>
                    <button type="submit" class="btn btn-success"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                        Guardar cambios</button>
                    </div>
                </form>
            </div>
        </section>

        @section Scripts {
            @{
                await Html.RenderPartialAsync("_ValidationScriptsPartial");
            }
            <script>
                $(document).ready(function () {
                    $('#IdInquilino').select2({
                        language: "es",
                        theme: 'bootstrap-5',
                        placeholder: "Buscar inquilino por nombre, apellido o DNI...",
                        minimumInputLength: 2,
                        allowClear: true,
                        ajax: {
                            delay: 250,
                            dataType: "json",
                            cache: true,
                            url: function (params) {
                                let q = params.term ? encodeURIComponent(params.term) : "";
                                return '@Url.Action("Buscar", "Inquilino")?term=' + q;
                            },
                            processResults: function (data) {
                                return { results: data };
                            }
                        }
                    });
                });
            </script>
        }