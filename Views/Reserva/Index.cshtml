@model IEnumerable<Cuello_Inmobiliaria_LAB2.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";
    var Pagina = ViewBag.Pagina ?? 1;
    var TotalPaginas = ViewBag.TotalPaginas ?? 1;

    var estadoActual = ViewBag.Estado as string;
    var desdeActual = ViewBag.Desde as DateTime?;
    var hastaActual = ViewBag.Hasta as DateTime?;
    var porTerminarActual = ViewBag.PorTerminar as int?;
    var totalRegistros = (int?)ViewBag.TotalRegistros ?? 0;

    var hayFiltros = !string.IsNullOrWhiteSpace(estadoActual)
                     || desdeActual.HasValue
                     || hastaActual.HasValue
                     || porTerminarActual.HasValue;
}

<section class="index-page">
    <header class="index-header">
        <div>
            <p class="index-eyebrow">Gestion de reservas</p>
            <h1>Reservas</h1>
            <p class="index-description">Administre las reservas, fechas y estados.</p>
        </div>
        <a class="btn btn-success index-create-button" asp-action="Create">
            <i class="fa-solid fa-plus" aria-hidden="true"></i><span>Nueva reserva</span>
        </a>
    </header>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @ViewBag.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filtros -->
    <div class="index-table-wrapper mb-3" style="padding: 1rem;">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label for="estado" class="form-label">Estado</label>
                <select id="estado" name="estado" class="form-control">
                    <option value="">Todas</option>
                    <option value="Vigente" selected="@(estadoActual == "Vigente")">Vigente</option>
                    <option value="Proxima" selected="@(estadoActual == "Proxima")">Próxima</option>
                    <option value="Finalizada" selected="@(estadoActual == "Finalizada")">Finalizada</option>
                    <option value="Terminada" selected="@(estadoActual == "Terminada")">Terminada</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="desde" class="form-label">Desde</label>
                <input type="date" id="desde" name="desde" class="form-control"
                       value="@(desdeActual?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <label for="hasta" class="form-label">Hasta</label>
                <input type="date" id="hasta" name="hasta" class="form-control"
                       value="@(hastaActual?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <label for="porTerminar" class="form-label">Terminan en (días)</label>
                <input type="number" id="porTerminar" name="porTerminar" class="form-control" min="1"
                       placeholder="Ej: 7" value="@porTerminarActual" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-success w-100">
                    <i class="fa-solid fa-magnifying-glass me-1"></i> Buscar
                </button>
                <a asp-action="Index" class="btn btn-secondary w-100">
                    <i class="fa-solid fa-eraser me-1"></i> Limpiar
                </a>
            </div>
        </form>
        @if (hayFiltros)
        {
            <small class="text-muted d-block mt-2">
                Mostrando @totalRegistros resultado(s) para los filtros aplicados.
            </small>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            @(hayFiltros
                ? "No se encontraron reservas con los filtros aplicados."
                : "No hay reservas registradas.")
        </div>
    }
    else
    {
        <div class="index-table-wrapper">
            <table class="table index-table reservation-index-table">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(m => m.IdReserva)</th>
                        <th>@Html.DisplayNameFor(m => m.Inmueble)</th>
                        <th>@Html.DisplayNameFor(m => m.Inquilino)</th>
                        <th>@Html.DisplayNameFor(m => m.FechaInicio)</th>
                        <th>@Html.DisplayNameFor(m => m.FechaFin)</th>
                        <th>@Html.DisplayNameFor(m => m.MontoDiario)</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(m => item.IdReserva)</td>
                            <td>@(item.Inmueble?.Direccion ?? "Sin inmueble")</td>
                            <td>@(item.Inquilino?.ToString() ?? "Sin inquilino")</td>
                            <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td>@item.FechaFin.ToString("dd/MM/yyyy")</td>
                            <td>@item.MontoDiario.ToString("C", new System.Globalization.CultureInfo("es-AR"))</td>
                            <td>
                                @if (item.EstaTerminada)
                                {
                                    <span class="badge bg-danger">Terminada</span>
                                }
                                else if (item.EstaVigente)
                                {
                                    <span class="badge bg-success">Vigente</span>
                                }
                                else if (item.FechaFin < DateTime.Today)
                                {
                                    <span class="badge bg-secondary">Finalizada</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Próxima</span>
                                }
                            </td>
                            <td>
                                <div class="index-actions" role="group">
                                    <a class="btn btn-info btn-sm" asp-action="Ver" asp-route-id="@item.IdReserva"
                                       title="Detalles">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@item.IdReserva"
                                       title="Editar">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    @if (!item.EstaVigente)
                                    {
                                        <a class="btn btn-danger btn-sm" asp-action="Eliminar" asp-route-id="@item.IdReserva"
                                           title="Eliminar">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-secondary btn-sm disabled"
                                           title="No se puede eliminar una reserva vigente">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Paginación -->
        <nav aria-label="Page navigation">
            <ul class="pagination">
                @if (Pagina > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(Pagina - 1)"
                           asp-route-estado="@estadoActual" asp-route-desde="@(desdeActual?.ToString("yyyy-MM-dd"))"
                           asp-route-hasta="@(hastaActual?.ToString("yyyy-MM-dd"))" asp-route-porTerminar="@porTerminarActual"
                           aria-label="Anterior">
                            <i class="fa-solid fa-angles-left"></i>
                        </a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link"><i class="fa-solid fa-angles-left"></i></span>
                    </li>
                }

                @for (int i = 1; i <= TotalPaginas; i++)
                {
                    <li class="page-item @(i == Pagina ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-estado="@estadoActual"
                           asp-route-desde="@(desdeActual?.ToString("yyyy-MM-dd"))"
                           asp-route-hasta="@(hastaActual?.ToString("yyyy-MM-dd"))"
                           asp-route-porTerminar="@porTerminarActual">@i</a>
                    </li>
                }

                @if (Pagina < TotalPaginas)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(Pagina + 1)"
                           asp-route-estado="@estadoActual" asp-route-desde="@(desdeActual?.ToString("yyyy-MM-dd"))"
                           asp-route-hasta="@(hastaActual?.ToString("yyyy-MM-dd"))" asp-route-porTerminar="@porTerminarActual"
                           aria-label="Siguiente">
                            <i class="fa-solid fa-angles-right"></i>
                        </a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link"><i class="fa-solid fa-angles-right"></i></span>
                    </li>
                }
            </ul>
        </nav>
    }
</section>