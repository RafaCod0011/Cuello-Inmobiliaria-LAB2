@model IEnumerable<Cuello_Inmobiliaria_LAB2.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";
    var Pagina = ViewBag.Pagina ?? 1;
    var TotalPaginas = ViewBag.TotalPaginas ?? 1;
}

<section class="index-page">
    <header class="index-header">
        <div>
            <p class="index-eyebrow">Gestion de reservas</p>
            <h1>Reservas</h1>
            <p class="index-description">Administre las reservas, fechas y estados.</p>
        </div><a class="btn btn-success index-create-button" asp-action="Create"><i class="fa-solid fa-plus"
                                                                                    aria-hidden="true"></i><span>Nueva reserva</span></a>
    </header>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @ViewBag.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="index-table-wrapper">
        <table class="table index-table reservation-index-table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(m => m.IdReserva)</th>
                    <th>@Html.DisplayNameFor(m => m.Inmueble)</th>
                    <th>@Html.DisplayNameFor(m => m.Inquilino)</th>
                    <th>@Html.DisplayNameFor(m => m.FechaInicio)</th>
                    <th>@Html.DisplayNameFor(m => m.FechaFin)</th>
                    <th>@Html.DisplayNameFor(m => m.MontoDiario)</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(m => item.IdReserva)</td>
                        <td>@(item.Inmueble?.Direccion ?? "Sin inmueble")</td>
                        <td>@(item.Inquilino?.ToString() ?? "Sin inquilino")</td>
                        <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td>@item.FechaFin.ToString("dd/MM/yyyy")</td>
                        <td>@item.MontoDiario.ToString("C", new System.Globalization.CultureInfo("es-AR"))</td>
                        <td>
                            @if (item.EstaTerminada)
                            {
                                <span class="badge bg-danger">Terminada</span>
                            }
                            else if (item.EstaVigente)
                            {
                                <span class="badge bg-success">Vigente</span>
                            }
                            else if (item.FechaFin < DateTime.Today)
                            {
                                <span class="badge bg-secondary">Finalizada</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Próxima</span>
                            }
                        </td>
                        <td>
                            <div class="index-actions" role="group">
                                <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@item.IdReserva"
                                   title="Detalles">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@item.IdReserva"
                                   title="Editar">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <a class="btn btn-danger btn-sm" asp-action="Eliminar" asp-route-id="@item.IdReserva"
                                   title="Eliminar">
                                    <i class="fa-solid fa-trash-can"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    <nav aria-label="Page navigation">
        <ul class="pagination">
            @if (Pagina > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(Pagina - 1)" aria-label="Anterior">
                        <i class="fa-solid fa-angles-left"></i>
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link"><i class="fa-solid fa-angles-left"></i></span>
                </li>
            }

            @for (int i = 1; i <= TotalPaginas; i++)
            {
                <li class="page-item @(i == Pagina ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@i">@i</a>
                </li>
            }

            @if (Pagina < TotalPaginas)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(Pagina + 1)" aria-label="Siguiente">
                        <i class="fa-solid fa-angles-right"></i>
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link"><i class="fa-solid fa-angles-right"></i></span>
                </li>
            }
        </ul>
    </nav></section>