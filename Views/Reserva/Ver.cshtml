@model Cuello_Inmobiliaria_LAB2.Models.Reserva

@{
    ViewData["Title"] = $"Detalles de Reserva #{Model.IdReserva}";
    var extensiones = (IList<Cuello_Inmobiliaria_LAB2.Models.Reserva>)ViewBag.Extensiones
        ?? new List<Cuello_Inmobiliaria_LAB2.Models.Reserva>();
    var reservaOrigen = (Cuello_Inmobiliaria_LAB2.Models.Reserva)ViewBag.ReservaOrigen;
    var esAdmin = User.IsInRole("Administrador");
}

<section class="details-page">
    <div class="details-card reservation-details-card">
        <header class="edit-card-header">
            <div class="edit-icon" aria-hidden="true">
                <i class="fa-solid fa-calendar-check"></i>
            </div>
            <div>
                <p class="edit-eyebrow">Gestion de reservas</p>
                <h1>Detalles de la reserva</h1>
                <p class="edit-description">Consulte el estado y la información completa.</p>
            </div>
        </header>

        <div class="reservation-details-content">
            @if (reservaOrigen != null)
            {
                <div class="alert alert-info">
                    <i class="fa-solid fa-circle-info me-2"></i>
                    Esta reserva es una <strong>extensión</strong> de la reserva
                    <a asp-action="Ver" asp-route-id="@reservaOrigen.IdReserva" class="alert-link">
                        #@reservaOrigen.IdReserva
                    </a>
                </div>
            }

            <dl class="details-list">
                <div class="details-row">
                    <dt>@Html.DisplayNameFor(m => m.IdReserva)</dt>
                    <dd>@Html.DisplayFor(m => m.IdReserva)</dd>
                </div>

                <div class="details-row">
                    <dt>Inmueble</dt>
                    <dd>@(Model.Inmueble?.Direccion ?? "Sin inmueble")</dd>
                </div>

                <div class="details-row">
                    <dt>Inquilino</dt>
                    <dd>@(Model.Inquilino?.ToString() ?? "Sin inquilino")</dd>
                </div>

                <div class="details-row">
                    <dt>@Html.DisplayNameFor(m => m.FechaInicio)</dt>
                    <dd>@Model.FechaInicio.ToString("dd/MM/yyyy")</dd>
                </div>

                <div class="details-row">
                    <dt>@Html.DisplayNameFor(m => m.FechaFin)</dt>
                    <dd>@Model.FechaFin.ToString("dd/MM/yyyy")</dd>
                </div>

                <div class="details-row">
                    <dt>@Html.DisplayNameFor(m => m.MontoDiario)</dt>
                    <dd>@Model.MontoDiario.ToString("C", new System.Globalization.CultureInfo("es-AR"))</dd>
                </div>

                <div class="details-row">
                    <dt>Monto total</dt>
                    <dd>@Model.MontoTotal.ToString("C", new System.Globalization.CultureInfo("es-AR"))</dd>
                </div>

                <div class="details-row">
                    <dt>Estado</dt>
                    <dd>
                        @if (Model.EstaTerminada)
                        {
                            <span class="badge bg-danger">Terminada</span>
                        }
                        else if (Model.EstaVigente)
                        {
                            <span class="badge bg-success">Vigente</span>
                        }
                        else if (Model.FechaFin < DateTime.Today)
                        {
                            <span class="badge bg-secondary">Finalizada</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">Próxima</span>
                        }
                    </dd>
                </div>
            </dl>
            @if (esAdmin)
            {
                <h4 class="mt-4">Auditoría</h4>
                <dl class="details-list">
                    <div class="details-row">
                        <dt>Creada por</dt>
                        <dd>
                            @(Model.UsuarioCreacion?.ToString() ?? "N/A")
                            <br />
                            <small class="text-muted">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</small>
                        </dd>
                    </div>

                    @if (Model.IdUsuarioTerminacion != null)
                    {
                        <div class="details-row">
                            <dt>Terminada por</dt>
                            <dd>
                                @(Model.UsuarioTerminacion?.ToString() ?? "N/A")
                                <br />
                                <small class="text-muted">@Model.FechaTerminacionAnticipada?.ToString("dd/MM/yyyy")</small>
                            </dd>
                        </div>
                    }
                </dl>
            }
            @if (extensiones.Any())
            {
                <h4 class="mt-4">Extensiones</h4>
                <div class="index-table-wrapper">
                    <table class="table index-table">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Fecha de inicio</th>
                                <th>Fecha de fin</th>
                                <th>Monto diario</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ext in extensiones)
                            {
                                <tr>
                                    <td>#@ext.IdReserva</td>
                                    <td>@ext.FechaInicio.ToString("dd/MM/yyyy")</td>
                                    <td>@ext.FechaFin.ToString("dd/MM/yyyy")</td>
                                    <td>@ext.MontoDiario.ToString("C", new System.Globalization.CultureInfo("es-AR"))</td>
                                    <td>
                                        @if (ext.EstaTerminada)
                                        {
                                            <span class="badge bg-danger">Terminada</span>
                                        }
                                        else if (ext.EstaVigente)
                                        {
                                            <span class="badge bg-success">Vigente</span>
                                        }
                                        else if (ext.FechaFin < DateTime.Today)
                                        {
                                            <span class="badge bg-secondary">Finalizada</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Próxima</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Ver" asp-route-id="@ext.IdReserva" class="btn btn-info btn-sm"
                                           title="Ver extensión">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="d-flex justify-content-between align-items-center mt-4">
                <h4 class="mb-0">Pagos asociados</h4>

                @if (!Model.EstaTerminada)
                {
                    <button class="btn btn-success btn-sm" onclick="mostrarModalNuevoPago()">
                        <i class="fa-solid fa-plus me-1"></i> Registrar pago
                    </button>
                }
            </div>

            @if (Model.Pagos != null && Model.Pagos.Any())
            {
                <div class="index-table-wrapper mt-2">
                    <table class="table index-table">
                        <thead>
                            <tr>
                                <th>Concepto</th>
                                <th>Fecha</th>
                                <th>Importe</th>
                                <th>Estado</th>
                                @if (esAdmin)
                                {
                                    <th>Creado por</th>
                                    <th>Anulado por</th>
                                }
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pago in Model.Pagos)
                            {
                                <tr>
                                    <td>@pago.Concepto</td>
                                    <td>@pago.FechaPago.ToString("dd/MM/yyyy")</td>
                                    <td>@pago.Importe.ToString("C", new System.Globalization.CultureInfo("es-AR"))</td>
                                    <td>
                                        @if (pago.Anulado)
                                        {
                                            <span class="badge bg-danger">Anulado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                    </td>

                                    @if (esAdmin)
                                    {
                                        <td>
                                            @(pago.UsuarioCreacion?.ToString() ?? "N/A")
                                            <br />
                                            <small class="text-muted">@pago.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</small>
                                        </td>
                                        <td>
                                            @if (pago.Anulado && pago.UsuarioAnulacion != null)
                                            {
                                                @pago.UsuarioAnulacion.ToString()
                                                <br />
                                                <small class="text-muted">@pago.FechaAnulacion?.ToString("dd/MM/yyyy HH:mm")</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                    }

                                    <td>
                                        @if (!pago.Anulado)
                                        {
                                            <button class="btn btn-outline-primary btn-sm" title="Editar concepto"
                                                    data-id="@pago.IdPago" data-concepto="@pago.Concepto"
                                                    onclick="mostrarModalEditarPago(this)">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm" title="Anular pago"
                                                    onclick="anularPago(@pago.IdPago)">
                                                <i class="fa-solid fa-ban"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="mt-2">No hay pagos registrados.</p>
            }

            <div class="details-actions">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left me-2" aria-hidden="true"></i><span>Volver a la lista</span>
                </a>
                <a asp-action="Edit" asp-route-id="@Model.IdReserva" class="btn btn-primary">
                    <i class="fa-solid fa-pen me-2" aria-hidden="true"></i><span>Editar</span>
                </a>

                @if (ViewBag.PuedeTerminar == true)
                {
                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modalTerminar">
                        <i class="fa-solid fa-xmark me-2" aria-hidden="true"></i><span>Terminar anticipadamente</span>
                    </button>
                }

                @if (!Model.EstaTerminada && (Model.EstaVigente || Model.EsProxima))
                {
                    <a asp-action="Extender" asp-route-id="@Model.IdReserva" class="btn btn-success">
                        <i class="fa-solid fa-calendar-plus"></i> Extender
                    </a>
                }
            </div>

            <!-- Terminar anticipadamente -->
            <div class="modal fade" id="modalTerminar" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-action="Terminar" asp-route-id="@Model.IdReserva" method="post">
                            <div class="modal-header">
                                <h5 class="modal-title">Terminar reserva anticipadamente</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                        aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="form-group">
                                    <label for="fechaTerminacion" class="control-label">Fecha de terminación</label>
                                    <input type="date" id="fechaTerminacion" name="fechaTerminacion"
                                           class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                </div>
                                <p class="text-muted mt-2">Se calculará automáticamente la multa según las reglas.</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary"
                                        data-bs-dismiss="modal">Cancelar</button>
                                <input type="submit" value="Confirmar terminación" class="btn btn-danger" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Nuevo pago -->
            <div class="modal fade" id="modalNuevoPago" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Registrar nuevo pago</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="form-group mb-3">
                                <label>Concepto</label>
                                <input type="text" id="nuevoPagoConcepto" class="form-control" required />
                            </div>
                            <div class="form-group mb-3">
                                <label>Importe</label>
                                <input type="number" step="0.01" id="nuevoPagoImporte" class="form-control" required />
                            </div>
                            <div class="form-group mb-3">
                                <label>Fecha de pago</label>
                                <input type="date" id="nuevoPagoFecha" class="form-control"
                                       value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div id="errorNuevoPago" class="alert alert-danger d-none"></div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="button" class="btn btn-success" onclick="guardarNuevoPago()">
                                <i class="fa-solid fa-save me-1"></i> Guardar
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Concepto de pago -->
            <div class="modal fade" id="modalEditarPago" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Editar concepto del pago</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" id="editarPagoId" />
                            <div class="form-group mb-3">
                                <label>Concepto</label>
                                <input type="text" id="editarPagoConcepto" class="form-control" required />
                            </div>
                            <div id="errorEditarPago" class="alert alert-danger d-none"></div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="button" class="btn btn-success" onclick="guardarEditarPago()">
                                <i class="fa-solid fa-save me-1"></i> Guardar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const urlCrearPago = '@Url.Action("Crear", "Pago")';
        const urlEditarPago = '@Url.Action("EditarConcepto", "Pago")';
        const urlAnularPago = '@Url.Action("Anular", "Pago")';
        const idReserva = @Model.IdReserva;

        function mostrarModalNuevoPago() {
            document.getElementById('nuevoPagoConcepto').value = '';
            document.getElementById('nuevoPagoImporte').value = '';
            document.getElementById('nuevoPagoFecha').value = '@DateTime.Today.ToString("yyyy-MM-dd")';
            document.getElementById('errorNuevoPago').classList.add('d-none');
            $('#modalNuevoPago').modal('show');
        }

        function guardarNuevoPago() {
            const concepto = document.getElementById('nuevoPagoConcepto').value.trim();
            const importe = parseFloat(document.getElementById('nuevoPagoImporte').value);
            const fechaPago = document.getElementById('nuevoPagoFecha').value;
            const errorDiv = document.getElementById('errorNuevoPago');

            errorDiv.classList.add('d-none');

            if (!concepto || isNaN(importe) || importe <= 0 || !fechaPago) {
                errorDiv.textContent = 'Complete todos los campos correctamente.';
                errorDiv.classList.remove('d-none');
                return;
            }

            $.ajax({
                url: urlCrearPago,
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    Concepto: concepto,
                    Importe: importe,
                    FechaPago: fechaPago,
                    IdReserva: idReserva
                }),
                success: (data) => {
                    if (data.success) {
                        location.reload();
                    } else {
                        errorDiv.textContent = data.error || 'Error al crear el pago';
                        errorDiv.classList.remove('d-none');
                    }
                },
                error: (xhr) => {
                    errorDiv.textContent = xhr.responseJSON?.error || 'Error al crear el pago';
                    errorDiv.classList.remove('d-none');
                }
            });
        }

        function mostrarModalEditarPago(btn) {
            const idPago = parseInt(btn.dataset.id);
            const conceptoActual = btn.dataset.concepto;

            document.getElementById('editarPagoId').value = idPago;
            document.getElementById('editarPagoConcepto').value = conceptoActual;
            document.getElementById('errorEditarPago').classList.add('d-none');

            $('#modalEditarPago').modal('show');
        }

        function guardarEditarPago() {
            const idPago = parseInt(document.getElementById('editarPagoId').value);
            const concepto = document.getElementById('editarPagoConcepto').value.trim();
            const errorDiv = document.getElementById('errorEditarPago');

            errorDiv.classList.add('d-none');

            if (!concepto) {
                errorDiv.textContent = 'El concepto es obligatorio.';
                errorDiv.classList.remove('d-none');
                return;
            }

            $.ajax({
                url: urlEditarPago,
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ IdPago: idPago, Concepto: concepto }),
                success: (data) => {
                    if (data.success) {
                        location.reload();
                    } else {
                        errorDiv.textContent = data.error || 'Error al editar el concepto';
                        errorDiv.classList.remove('d-none');
                    }
                },
                error: (xhr) => {
                    errorDiv.textContent = xhr.responseJSON?.error || 'Error al editar el concepto';
                    errorDiv.classList.remove('d-none');
                }
            });
        }

        function anularPago(idPago) {
            if (!confirm('¿Está seguro de anular este pago?')) return;

            $.ajax({
                url: urlAnularPago + '/' + idPago,
                method: 'POST',
                success: (data) => {
                    if (data.success) {
                        location.reload();
                    }
                },
                error: (xhr) => {
                    alert(xhr.responseJSON?.error || 'Error al anular el pago');
                }
            });
        }
    </script>
}