@model Cuello_Inmobiliaria_LAB2.Models.Reserva

@{
    ViewData["Title"] = "Nueva Reserva";
    var inmuebles = (IList<Cuello_Inmobiliaria_LAB2.Models.Inmueble>)ViewBag.Inmuebles;
}

<section class="edit-page">
    <div class="edit-card reservation-card">
        <header class="edit-card-header">
            <div class="edit-icon" aria-hidden="true"><i class="fa-solid fa-calendar-plus"></i></div>
            <div>
                <p class="edit-eyebrow">Gestion de reservas</p>
                <h1>Nueva reserva</h1>
                <p class="edit-description">Complete los datos para registrar una reserva.</p>
            </div>
        </header>

        <form asp-action="Create" class="edit-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="edit-fields reservation-fields">
                <div class="form-group reservation-wide-field">
                    <label asp-for="IdInmueble" class="control-label"></label>
                    <select asp-for="IdInmueble" class="form-control" id="IdInmueble">
                        <option value="">Seleccionar inmueble</option>
                        @foreach (var item in inmuebles)
                        {
                            <option value="@item.IdInmueble"
                                    data-precio="@item.PrecioPorDia.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                @item.Direccion
                            </option>
                        }
                    </select>
                    <span asp-validation-for="IdInmueble" class="text-danger"></span>
                </div>
                <div class="form-group reservation-wide-field">
                    <label asp-for="IdInquilino" class="control-label"></label>
                    <select asp-for="IdInquilino" class="form-control select2"></select>
                    <span asp-validation-for="IdInquilino" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="FechaInicio" class="control-label"></label>
                    <input asp-for="FechaInicio" class="form-control" type="date" />
                    <span asp-validation-for="FechaInicio" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="FechaFin" class="control-label"></label>
                    <input asp-for="FechaFin" class="form-control" type="date" />
                    <span asp-validation-for="FechaFin" class="text-danger"></span>
                </div>
                <div class="form-group reservation-wide-field">
                    <label asp-for="MontoDiario" class="control-label"></label>
                    <input asp-for="MontoDiario" class="form-control" />
                    <span asp-validation-for="MontoDiario" class="text-danger"></span>
                </div>
            </div>
            <div class="edit-actions">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left me-2" aria-hidden="true"></i><span>Volver a la lista</span>
                </a>
                <button type="submit" class="btn btn-success"><i class="fa-solid fa-calendar-plus"
                                                                     aria-hidden="true"></i> Crear reserva</button>
                </div>
            </form>
        </div>
    </section>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }

        <script>
            $(document).ready(function () {
                $('#IdInquilino').select2({
                    language: "es",
                    theme: 'bootstrap-5',
                    placeholder: "Buscar inquilino por nombre, apellido o DNI...",
                    minimumInputLength: 2,
                    allowClear: true,
                    ajax: {
                        delay: 250,
                        dataType: "json",
                        cache: true,
                        url: function (params) {
                            let q = params.term ? encodeURIComponent(params.term) : "";
                            return '@Url.Action("Buscar", "Inquilino")?term=' + q;
                        },
                        processResults: function (data) {
                            return { results: data };
                        }
                    }
                });
            });
            $(document).ready(function () {
                $('#IdInmueble').on('change', function () {
                    var selected = $(this).find('option:selected');
                    var precio = selected.data('precio');
                    if (precio) {
                        $('#MontoDiario').val(precio);
                    }
                });

                // Si ya hay un inmueble seleccionado (ej. en edición), cargar su precio
                var precioInicial = $('#IdInmueble option:selected').data('precio');
                if (precioInicial) {
                    $('#MontoDiario').val(precioInicial);
                }
            });
        </script>
    }