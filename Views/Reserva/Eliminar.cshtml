@model Cuello_Inmobiliaria_LAB2.Models.Reserva

@{
    ViewData["Title"] = "Eliminar Reserva";
}

<section class="delete-page">
    <div class="delete-card reservation-delete-card">
        <header class="delete-card-header">
            <div class="delete-icon" aria-hidden="true"><i class="fa-solid fa-calendar-xmark"></i></div>
            <div>
                <p class="delete-eyebrow">Accion irreversible</p>
                <h1>Eliminar reserva</h1>
                <p class="delete-question">¿Seguro que desea eliminar esta reserva?</p>
            </div>
        </header>
        <div class="delete-details">
            <h2>Datos de la reserva</h2>
            <dl>
                <div class="delete-detail">
                    <dt>@Html.DisplayNameFor(m => m.IdReserva)</dt>
                    <dd>@Html.DisplayFor(m => m.IdReserva)</dd>
                </div>

                <div class="delete-detail">
                    <dt>Inmueble</dt>
                    <dd>@(Model.Inmueble?.Direccion ?? "Sin inmueble")</dd>
                </div>

                <div class="delete-detail">
                    <dt>Inquilino</dt>
                    <dd>@(Model.Inquilino?.ToString() ?? "Sin inquilino")</dd>
                </div>

                <div class="delete-detail">
                    <dt>@Html.DisplayNameFor(m => m.FechaInicio)</dt>
                    <dd>@Model.FechaInicio.ToShortDateString()</dd>
                </div>

                <div class="delete-detail">
                    <dt>@Html.DisplayNameFor(m => m.FechaFin)</dt>
                    <dd>@Model.FechaFin.ToShortDateString()</dd>
                </div>
            </dl>
        </div>

        <form asp-action="Eliminar" asp-route-id="@Model.IdReserva" class="delete-actions">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left me-2" aria-hidden="true"></i><span>Volver a la lista</span>
            </a>
            <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                Eliminar reserva</button>
            </form>
        </div></section>