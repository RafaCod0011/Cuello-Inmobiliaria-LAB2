@{
    ViewData["Title"] = "Inicio";
}

<div class="dashboard-header text-center">
    <h1>Panel Principal</h1>
    <p class="text-muted">Sistema de Gestión Inmobiliaria</p>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-6 col-md-4 col-lg-3">
        <a asp-controller="Propietario" asp-action="Index" class="dashboard-card">
            <div class="dashboard-card-icon icon-blue">
                <i class="fa-solid fa-user-tie"></i>
            </div>
            <h5>Propietarios</h5>
            <p>Administración de propietarios</p>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg-3">
        <a asp-controller="Inquilino" asp-action="Index" class="dashboard-card">
            <div class="dashboard-card-icon icon-green">
                <i class="fa-solid fa-key"></i>
            </div>
            <h5>Inquilinos</h5>
            <p>Administración de inquilinos</p>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg-3">
        <div class="dashboard-card">
            <div class="dashboard-card-icon icon-purple">
                <i class="fa-solid fa-house"></i>
            </div>
            <h5>Inmuebles</h5>
            <p>Administración de inmuebles</p>
            <div class="dashboard-card-actions">
                <button class="dashboard-action" type="button">
                    <i class="fa-solid fa-circle-check"></i>
                    Ver disponibles
                </button>
                <button class="dashboard-action" type="button">
                    <i class="fa-solid fa-users"></i>
                    Ver por propietarios
                </button>
                <a asp-controller="Inmueble" asp-action="Index" class="dashboard-action dashboard-action-link">
                    <i class="fa-solid fa-list"></i>
                    Ver todos
                </a>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-3">
        <a asp-controller="TipoInmueble" asp-action="Index" class="dashboard-card">
            <div class="dashboard-card-icon icon-blue">
                <i class="fa-solid fa-user-tie"></i>
            </div>
            <h5>Tipos de Inmuebles</h5>
            <p>Administración de tipos de inmuebles</p>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg-3">
        <div class="dashboard-card">
            <div class="dashboard-card-icon icon-orange">
                <i class="fa-solid fa-calendar-check"></i>
            </div>
            <h5>Reservas</h5>
            <p>Administración de reservas</p>
            <div class="dashboard-card-actions">
                <a asp-controller="Reserva" asp-action="Create" class="dashboard-action dashboard-action-link">
                    <i class="fa-solid fa-calendar-plus"></i>
                    Crear reserva
                </a>
                <a asp-controller="Reserva" asp-action="BuscarInquilino" class="dashboard-action dashboard-action-link">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    Crear reserva guiada
                </a>
                <a asp-controller="Reserva" asp-action="Index" class="dashboard-action dashboard-action-link">
                    <i class="fa-solid fa-list"></i>
                    Ver todas
                </a>
            </div>
        </div>
    </div>
</div>
