@model Cuello_Inmobiliaria_LAB2.Models.Inmueble

@{
    ViewData["Title"] = "Detalles del Inmueble";
    var lat = Model.Latitud ?? 0;
    var lng = Model.Longitud ?? 0;
    var direccion = Model.Direccion ?? "";
}

<h1>Detalles del Inmueble</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.IdInmueble)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.IdInmueble)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Direccion)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Direccion)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Cupo)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Cupo)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.PrecioPorDia)
            </dt>
            <dd class="col-sm-9">
                @Model.PrecioPorDia.ToString("C", new System.Globalization.CultureInfo("es-AR"))
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.PorcentajeReserva)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.PorcentajeReserva) %
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Estado)
            </dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.Estado == EstadoInmueble.Activo ? "bg-success" : "bg-warning")">
                    @Html.DisplayFor(model => model.Estado)
                </span>
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Propietario)
            </dt>
            <dd class="col-sm-9">
                @(Model.Propietario?.ToString() ?? "Sin propietario")
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Tipo)
            </dt>
            <dd class="col-sm-9">
                @(Model.Tipo?.Nombre ?? "Sin tipo")
            </dd>

            @if (Model.Latitud.HasValue || Model.Longitud.HasValue)
            {
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Latitud)
                </dt>
                <dd class="col-sm-9">
                    @(Model.Latitud?.ToString("0.000000") ?? "N/A")
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Longitud)
                </dt>
                <dd class="col-sm-9">
                    @(Model.Longitud?.ToString("0.000000") ?? "N/A")
                </dd>
            }
        </dl>
    </div>

    <!-- Mapa -->
    <div class="col-md-6">
        @if (Model.Latitud.HasValue && Model.Longitud.HasValue && Model.Latitud != 0 && Model.Longitud != 0)
        {
            <div class="mt-2">
                <h4>Ubicación en el mapa</h4>
                <div id="mapa" style="height: 300px; width: 100%; border: 1px solid #ccc; border-radius: 4px;"></div>
            </div>
        }
        else
        {
            <div class="mt-2">
                <h4>Ubicación en el mapa</h4>
                <div class="alert alert-info">No hay coordenadas disponibles para este inmueble.</div>
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.IdInmueble" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>

@section Scripts {
    @if (Model.Latitud.HasValue && Model.Longitud.HasValue && Model.Latitud != 0 && Model.Longitud != 0)
    {
        <script type="text/javascript">
            $(document).ready(function () {
                var lat = @lat.ToString(System.Globalization.CultureInfo.InvariantCulture);
                var lng = @lng.ToString(System.Globalization.CultureInfo.InvariantCulture);
                var direccion = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(direccion));

                // Inicializar mapa
                var map = L.map('mapa').setView([lat, lng], 16);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                }).addTo(map);

                // Marcador (lectura)
                L.marker([lat, lng]).addTo(map)
                    .bindPopup(direccion || "Ubicación desconocida")
                    .openPopup();
            });
        </script>
    }
}