@model Cuello_Inmobiliaria_LAB2.Models.Inmueble

@{
    ViewData["Title"] = "Eliminar Inmueble";
}

<section class="delete-page">
    <div class="delete-card inmueble-delete-card">
        <header class="delete-card-header">
            <div class="delete-icon" aria-hidden="true"><i class="fa-solid fa-building-circle-xmark"></i></div>
            <div>
                <p class="delete-eyebrow">Accion irreversible</p>
                <h1>Eliminar inmueble</h1>
                <p class="delete-question">¿Seguro que desea eliminar este inmueble?</p>
            </div>
        </header>
        <div class="delete-details">
            <h2>Datos del inmueble</h2>
            <dl>
                <div class="delete-detail">
                    <dt>
                        @Html.DisplayNameFor(model => model.IdInmueble)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.IdInmueble)
                    </dd>
                </div>

                <div class="delete-detail">
                    <dt>
                        @Html.DisplayNameFor(model => model.Direccion)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.Direccion)
                    </dd>
                </div>

                <div class="delete-detail">
                    <dt>
                        @Html.DisplayNameFor(model => model.Cupo)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.Cupo)
                    </dd>
                </div>

                <div class="delete-detail">
                    <dt>
                        @Html.DisplayNameFor(model => model.PrecioPorDia)
                    </dt>
                    <dd>
                        @Model.PrecioPorDia.ToString("C", new System.Globalization.CultureInfo("es-AR"))
                    </dd>
                </div>

                <div class="delete-detail">
                    <dt>
                        @Html.DisplayNameFor(model => model.PorcentajeReserva)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.PorcentajeReserva)
                    </dd>
                </div>

                <div class="delete-detail">
                    <dt>
                        @Html.DisplayNameFor(model => model.Estado)
                    </dt>
                    <dd>
                        <span class="badge @(Model.Estado == EstadoInmueble.Activo ? "bg-success" : "bg-warning")">
                            @Html.DisplayFor(model => model.Estado)
                        </span>
                    </dd>
                </div>

                <div class="delete-detail">
                    <dt>
                        @Html.DisplayNameFor(model => model.Propietario)
                    </dt>
                    <dd>
                        @(Model.Propietario?.ToString() ?? "Sin propietario")
                    </dd>
                </div>

                <div class="delete-detail">
                    <dt>
                        @Html.DisplayNameFor(model => model.Tipo)
                    </dt>
                    <dd>
                        @(Model.Tipo?.Nombre ?? "Sin tipo")
                    </dd>
                </div>
            </dl>
        </div>

        <form asp-action="Eliminar" asp-route-id="@Model.IdInmueble" class="delete-actions">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left me-2" aria-hidden="true"></i><span>Volver a la lista</span>
            </a>
            <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                Eliminar inmueble</button>
            </form>
        </div></section>