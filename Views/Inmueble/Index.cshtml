@model IEnumerable<Cuello_Inmobiliaria_LAB2.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles";
    var Pagina = ViewBag.Pagina ?? 1;
    var TotalPaginas = ViewBag.TotalPaginas ?? 1;
}

<section class="index-page">
    <header class="index-header">
        <div>
            <p class="index-eyebrow">Gestión de inmuebles</p>
            <h1>Inmuebles</h1>
            <p class="index-description">Administre las propiedades registradas en el sistema.</p>
        </div>
        <a class="btn btn-success index-create-button" asp-action="Create">
            <i class="fa-solid fa-plus" aria-hidden="true"></i><span>Nuevo inmueble</span>
        </a>
    </header>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @ViewBag.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="property-grid">
        @foreach (var item in Model)
        {
            var portada = item.Imagenes?.FirstOrDefault(i => i.Orden == 0) ?? item.Imagenes?.FirstOrDefault();
            <article class="property-card">
                <div class="property-cover">
                    @if (portada != null)
                    {
                        <img src="@portada.Ruta" alt="Portada de @item.Direccion" />
                    }
                    else
                    {
                        <div class="property-cover-placeholder">
                            <i class="fa-solid fa-building" aria-hidden="true"></i>
                            <span>Sin portada</span>
                        </div>
                    }
                    <span
                        class="property-status badge @(item.Estado == EstadoInmueble.Activo ? "bg-success" : "bg-warning")">
                        @Html.DisplayFor(modelItem => item.Estado)
                    </span>
                </div>
                <div class="property-content">
                    <div class="property-heading">
                        <span class="property-code">Código #@item.IdInmueble</span>
                        <h2>@item.Direccion</h2>
                    </div>
                    <dl class="property-data">
                        <div>
                            <dt>Tipo</dt>
                            <dd>@(item.Tipo?.Nombre ?? "Sin tipo")</dd>
                        </div>
                        <div>
                            <dt>Propietario</dt>
                            <dd>@(item.Propietario?.ToString() ?? "Sin propietario")</dd>
                        </div>
                        <div>
                            <dt>Cupo</dt>
                            <dd><i class="fa-solid fa-users" aria-hidden="true"></i> @item.Cupo personas</dd>
                        </div>
                        <div>
                            <dt>Precio por día</dt>
                            <dd class="property-price">@item.PrecioPorDia.ToString("C", new
                                                            System.Globalization.CultureInfo("es-AR"))</dd>
                            </div>
                            <div>
                                <dt>Reserva</dt>
                                <dd>@item.PorcentajeReserva.ToString("0.##")%</dd>
                            </div>
                            <div>
                                <dt>Latitud</dt>
                                <dd>@(item.Latitud?.ToString("0.000000") ?? "No disponible")</dd>
                            </div>
                            <div>
                                <dt>Longitud</dt>
                                <dd>@(item.Longitud?.ToString("0.000000") ?? "No disponible")</dd>
                            </div>
                        </dl>
                        <div class="property-actions" role="group" aria-label="Acciones del inmueble">
                            <a class="btn btn-primary" asp-action="Ver" asp-route-id="@item.IdInmueble" title="Ver inmueble"><i
                                class="fa-solid fa-eye" aria-hidden="true"></i><span>Ver</span></a>
                                <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@item.IdInmueble"
                                   title="Editar inmueble"><i class="fa-solid fa-pen"
                                                               aria-hidden="true"></i><span>Editar</span></a>
                                    <a class="btn btn-outline-secondary" asp-action="Imagenes" asp-route-id="@item.IdInmueble"
                                       title="Gestionar imágenes"><i class="fa-solid fa-images" aria-hidden="true"></i></a>
                                    <a class="btn btn-outline-danger" asp-action="Eliminar" asp-route-id="@item.IdInmueble"
                                       title="Eliminar inmueble"><i class="fa-solid fa-trash-can" aria-hidden="true"></i></a>
                                </div>
                            </div>
                        </article>
                    }
                </div>

                <!-- Paginación -->
                <nav aria-label="Page navigation">
                    <ul class="pagination">
                        @if (Pagina > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-pagina="@(Pagina - 1)" aria-label="Anterior">
                                    <i class="fa-solid fa-angles-left"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link"><i class="fa-solid fa-angles-left"></i></span>
                            </li>
                        }

                        @for (int i = 1; i <= TotalPaginas; i++)
                        {
                            <li class="page-item @(i == Pagina ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-pagina="@i">@i</a>
                            </li>
                        }

                        @if (Pagina < TotalPaginas)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-pagina="@(Pagina + 1)" aria-label="Siguiente">
                                    <i class="fa-solid fa-angles-right"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link"><i class="fa-solid fa-angles-right"></i></span>
                            </li>
                        }
                    </ul>
                </nav>
            </section>