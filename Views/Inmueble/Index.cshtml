@model IEnumerable<Cuello_Inmobiliaria_LAB2.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles";
    var Pagina = ViewBag.Pagina ?? 1;
    var TotalPaginas = ViewBag.TotalPaginas ?? 1;
}

<h1>
    Inmuebles
    <div class="btn-group pull-right">
        <a class="btn btn-success" asp-action="Create" title="Crear"><i class="fa-solid fa-plus"></i></a>
    </div>
</h1>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @ViewBag.Mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<table class="table table-bordered">
    <thead>
        <tr class="table-success">
            <th>@Html.DisplayNameFor(model => model.IdInmueble)</th>
            <th>@Html.DisplayNameFor(model => model.Direccion)</th>
            <th>@Html.DisplayNameFor(model => model.Cupo)</th>
            <th>@Html.DisplayNameFor(model => model.PrecioPorDia)</th>
            <th>@Html.DisplayNameFor(model => model.PorcentajeReserva)</th>
            <th>@Html.DisplayNameFor(model => model.Estado)</th>
            <th>Propietario</th>
            <th>Tipo</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.IdInmueble)</td>
                <td>@Html.DisplayFor(modelItem => item.Direccion)</td>
                <td>@Html.DisplayFor(modelItem => item.Cupo)</td>
                <td>@item.PrecioPorDia.ToString("C", new System.Globalization.CultureInfo("es-AR"))</td>
                <td>@Html.DisplayFor(modelItem => item.PorcentajeReserva)</td>
                <td>
                    <span class="badge @(item.Estado == EstadoInmueble.Activo ? "bg-success" : "bg-warning")">
                        @Html.DisplayFor(modelItem => item.Estado)
                    </span>
                </td>
                <td>@(item.Propietario?.ToString() ?? "Sin propietario")</td>
                <td>@(item.Tipo?.Nombre ?? "Sin tipo")</td>
                <td>
                    <div class="btn-group" role="group">
                        <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@item.IdInmueble" title="Editar">
                            <i class="fa-solid fa-pen"></i>
                        </a>
                        <a class="btn btn-danger btn-sm" asp-action="Eliminar" asp-route-id="@item.IdInmueble"
                           title="Eliminar">
                            <i class="fa-solid fa-trash-can"></i>
                        </a>
                        <a class="btn btn-info btn-sm" asp-action="Ver" asp-route-id="@item.IdInmueble" title="Ver">
                            <i class="fa-solid fa-eye"></i>
                        </a>
                        <a class="btn btn-warning btn-sm" asp-action="Imagenes" asp-route-id="@item.IdInmueble"
                           title="Ver imágenes">
                            <i class="fa-solid fa-images"></i>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Paginación -->
<nav aria-label="Page navigation">
    <ul class="pagination">
        @if (Pagina > 1)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-pagina="@(Pagina - 1)" aria-label="Anterior">
                    <i class="fa-solid fa-angles-left"></i>
                </a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link"><i class="fa-solid fa-angles-left"></i></span>
            </li>
        }

        @for (int i = 1; i <= TotalPaginas; i++)
        {
            <li class="page-item @(i == Pagina ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@i">@i</a>
            </li>
        }

        @if (Pagina < TotalPaginas)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-pagina="@(Pagina + 1)" aria-label="Siguiente">
                    <i class="fa-solid fa-angles-right"></i>
                </a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link"><i class="fa-solid fa-angles-right"></i></span>
            </li>
        }
    </ul>
</nav>