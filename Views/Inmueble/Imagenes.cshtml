@using Cuello_Inmobiliaria_LAB2.Models
@model Cuello_Inmobiliaria_LAB2.Models.Inmueble

@{
    ViewData["Title"] = "Imágenes del Inmueble";
    var inmuebleId = Model.IdInmueble;
}

<section class="media-page">
    <div class="media-card">
        <header class="edit-card-header">
            <div class="edit-icon" aria-hidden="true"><i class="fa-solid fa-images"></i></div>
            <div>
                <p class="edit-eyebrow">Gestión de inmuebles</p>
                <h1>Imágenes del inmueble</h1>
                <p class="edit-description">Cargue y administre las imágenes de esta propiedad. La primera imagen será
                    la portada automáticamente.</p>
                </div>
            </header>

            <div class="container media-content">
                <!-- Formulario para subir imágenes -->
                <div class="row">
                    <div class="col-md-12">
                        <h4>Subir imágenes</h4>
                        <form id="formImagenes" class="upload-form" enctype="multipart/form-data"
                              onsubmit="subirImagenes(event)">
                            <div class="upload-field">
                                <label for="imagenes">Seleccionar imágenes</label>
                                <input type="file" class="form-control-file" id="imagenes" name="imagenes"
                                       onchange="previsualizar(event)" accept="image/*" multiple required>
                            </div>
                            <button type="submit" class="btn btn-success upload-button">
                                <i class="fas fa-upload"></i> Subir imágenes
                            </button>
                        </form>

                        <div class="mt-3">
                            <h6>Previsualización:</h6>
                            <div id="preview" class="d-flex flex-wrap"></div>
                        </div>
                    </div>
                </div>

                <!-- Galería de imágenes actuales -->
                <div class="row mt-4">
                    <div class="col-md-12">
                        <h4>Imágenes actuales</h4>
                        <div class="d-flex flex-wrap" id="galeriaActual">
                            @if (Model.Imagenes != null && Model.Imagenes.Any())
                            {
                                foreach (var img in Model.Imagenes.OrderBy(i => i.Orden))
                                {
                                    <div class="m-2 position-relative imagen-con-hover" data-id="@img.IdImagen">
                                        <img src="@img.Ruta" class="img-thumbnail" style="max-width: 150px; max-height: 150px;" />

                                        @if (img.Orden == 0)
                                        {
                                            <span class="badge bg-warning position-absolute top-0 start-0 m-1" style="z-index:10;">
                                                <i class="fa-solid fa-star"></i> Portada
                                            </span>
                                        }

                                        <div class="btn-group-vertical position-absolute top-0 end-0 m-1" style="z-index:10;">
                                            @if (img.Orden != 0)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary"
                                                        onclick="marcarPortada(@img.IdImagen)" title="Marcar como portada">
                                                    <i class="fa-regular fa-star"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled
                                                        title="Es la portada">
                                                    <i class="fa-solid fa-check"></i>
                                                </button>
                                            }
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    onclick="eliminarImagen(@img.IdImagen)" title="Eliminar">
                                                <i class="fa-regular fa-trash-can"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p>No hay imágenes cargadas.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="media-footer">
                <a asp-action="Index" class="btn btn-outline-secondary">Volver a la lista</a>
            </div>
        </div>
    </section>

    @section Scripts {
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

        <script>
            const inmuebleId = @inmuebleId;

            function previsualizar(event) {
                $('#preview').empty();
                const files = event.target.files;
                if (!files) return;
                [...files].forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        $('#preview').append(`
                                <div class="m-2">
                                    <img src="${e.target.result}" class="img-thumbnail" style="max-width: 150px; max-height: 150px;" />
                                </div>
                            `);
                    };
                    reader.readAsDataURL(file);
                });
            }

            function subirImagenes(event) {
                event.preventDefault();
                const files = document.querySelector('#imagenes').files;
                if (files.length === 0) {
                    alert("Selecciona al menos una imagen");
                    return;
                }
                const formData = new FormData();
                for (let i = 0; i < files.length; i++) {
                    formData.append('imagenes', files[i]);
                }

                $.ajax({
                    url: `@Url.Action("Alta", "Imagenes", new { id = inmuebleId })`,
                    type: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                }).done(function (imagenes) {
                    alert('Imágenes subidas con éxito');
                    mostrarImagenes(imagenes);
                }).fail(function () {
                    alert('Error al subir las imágenes');
                }).always(function () {
                    document.getElementById('formImagenes').reset();
                    $('#preview').empty();
                    $('#imagenes').val("");
                });
            }

            function eliminarImagen(imagenId) {
                if (!confirm('¿Eliminar esta imagen?')) return;
                $.post(`@Url.Action("Eliminar", "Imagenes")/${imagenId}`)
                    .done(function (imagenes) {
                        alert('Imagen eliminada');
                        mostrarImagenes(imagenes);
                    })
                    .fail(function () {
                        alert('Error al eliminar la imagen');
                    });
            }

            function marcarPortada(imagenId) {
                $.post(`@Url.Action("MarcarPortada", "Imagenes")/${imagenId}`)
                    .done(function (imagenes) {
                        alert('Portada actualizada');
                        mostrarImagenes(imagenes);
                    })
                    .fail(function () {
                        alert('Error al marcar como portada');
                    });
            }

            function mostrarImagenes(imagenes) {
                if (imagenes && imagenes.length > 0) {
                    let html = '';
                    // Ordenar: la portada (orden 0) primero, luego el resto por orden
                    const sorted = [...imagenes].sort((a, b) => a.orden - b.orden);
                    sorted.forEach(img => {
                        const esPortada = img.orden === 0;
                        html += `
                                <div class="m-2 position-relative imagen-con-hover" data-id="${img.idImagen}">
                                    <img src="${img.ruta}" class="img-thumbnail" style="max-width: 150px; max-height: 150px;" />
                                    ${esPortada ? `
                                        <span class="badge bg-warning position-absolute top-0 start-0 m-1" style="z-index:10;">
                                            <i class="fa-solid fa-star"></i> Portada
                                        </span>
                                    ` : ''}
                                    <div class="btn-group-vertical position-absolute top-0 end-0 m-1" style="z-index:10;">
                                        ${esPortada ? `
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="Es la portada">
                                                <i class="fa-solid fa-check"></i>
                                            </button>
                                        ` : `
                                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="marcarPortada(${img.idImagen})" title="Marcar como portada">
                                                <i class="fa-regular fa-star"></i>
                                            </button>
                                        `}
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarImagen(${img.idImagen})" title="Eliminar">
                                            <i class="fa-regular fa-trash-can"></i>
                                        </button>
                                    </div>
                                </div>
                            `;
                    });
                    $('#galeriaActual').html(html);
                } else {
                    $('#galeriaActual').html('<p>No hay imágenes disponibles.</p>');
                }
            }
        </script>

        <style>
            .imagen-con-hover {
                position: relative;
            }

            .btn-eliminar-imagen {
                position: absolute;
                top: 5px;
                right: 5px;
                display: none;
            }

            .imagen-con-hover:hover .btn-eliminar-imagen {
                display: inline-block;
            }

            /* Estilos para los botones en la galería */
            .imagen-con-hover .btn-group-vertical .btn {
                border-radius: 0;
                padding: 2px 6px;
                font-size: 0.75rem;
            }

            .imagen-con-hover .btn-group-vertical .btn:first-child {
                border-top-left-radius: 4px;
                border-top-right-radius: 4px;
            }

            .imagen-con-hover .btn-group-vertical .btn:last-child {
                border-bottom-left-radius: 4px;
                border-bottom-right-radius: 4px;
            }
        </style>
    }