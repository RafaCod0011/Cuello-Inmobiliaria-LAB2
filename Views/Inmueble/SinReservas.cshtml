@model IEnumerable<Cuello_Inmobiliaria_LAB2.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles sin reservas";
    var Pagina = ViewBag.Pagina ?? 1;
    var TotalPaginas = ViewBag.TotalPaginas ?? 1;
    var dias = (int?)ViewBag.Dias ?? 30;
    var totalRegistros = (int?)ViewBag.TotalRegistros ?? 0;

    var opcionesDias = new[] { 30, 60, 90, 180, 365 };
}

<section class="index-page">
    <header class="index-header">
        <div>
            <p class="index-eyebrow">Informe</p>
            <h1>Inmuebles sin reservas</h1>
            <p class="index-description">
                Propiedades que no tuvieron reservas en los últimos <strong>@dias días</strong>
                (@totalRegistros en total)
            </p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Volver a Inmuebles
        </a>
    </header>

    <div class="index-table-wrapper mb-3" style="padding: 1rem;">
        <form asp-action="SinReservas" method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label for="dias" class="form-label">Período</label>
                <select id="dias" name="dias" class="form-control">
                    @foreach (var d in opcionesDias)
                    {
                        if (d == dias)
                        {
                            <option value="@d" selected>Últimos @d días</option>
                        }
                        else
                        {
                            <option value="@d">Últimos @d días</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-success w-100">
                    <i class="fa-solid fa-filter me-1"></i> Aplicar
                </button>
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-success">
            <i class="fa-solid fa-circle-check me-2"></i>
            Todos los inmuebles tuvieron reservas en los últimos @dias días.
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            Hay <strong>@totalRegistros inmueble(s)</strong> sin reservas en los últimos @dias días.
        </div>

        <div class="property-grid">
            @foreach (var item in Model)
            {
                var portada = item.Imagenes?.FirstOrDefault(i => i.Orden == 0) ?? item.Imagenes?.FirstOrDefault();
                <article class="property-card">
                    <div class="property-cover">
                        @if (portada != null)
                        {
                            <img src="@portada.Ruta" alt="Portada de @item.Direccion" />
                        }
                        else
                        {
                            <div class="property-cover-placeholder">
                                <i class="fa-solid fa-building" aria-hidden="true"></i>
                                <span>Sin portada</span>
                            </div>
                        }
                        <span
                            class="property-status badge @(item.Estado == EstadoInmueble.Activo ? "bg-success" : "bg-warning")">
                            @Html.DisplayFor(modelItem => item.Estado)
                        </span>
                    </div>
                    <div class="property-content">
                        <div class="property-heading">
                            <span class="property-code">Código #@item.IdInmueble</span>
                            <h2>@item.Direccion</h2>
                        </div>
                        <dl class="property-data">
                            <div>
                                <dt>Tipo</dt>
                                <dd>@(item.Tipo?.Nombre ?? "Sin tipo")</dd>
                            </div>
                            <div>
                                <dt>Propietario</dt>
                                <dd>@(item.Propietario?.ToString() ?? "Sin propietario")</dd>
                            </div>
                            <div>
                                <dt>Cupo</dt>
                                <dd><i class="fa-solid fa-users" aria-hidden="true"></i> @item.Cupo personas</dd>
                            </div>
                            <div>
                                <dt>Precio por día</dt>
                                <dd class="property-price">
                                    @item.PrecioPorDia.ToString("C", new System.Globalization.CultureInfo("es-AR"))
                                </dd>
                            </div>
                            <div>
                                <dt>Reserva</dt>
                                <dd>@item.PorcentajeReserva.ToString("0.##")%</dd>
                            </div>
                            <div>
                                <dt>Ubicación</dt>
                                <dd>
                                    @if (item.Latitud.HasValue && item.Longitud.HasValue)
                                    {
                                        <text>@item.Latitud.Value.ToString("0.0000"), @item.Longitud.Value.ToString("0.0000")</text>
                                    }
                                    else
                                    {
                                        <text>No disponible</text>
                                    }
                                </dd>
                            </div>
                        </dl>
                        <div class="property-actions" role="group" aria-label="Acciones del inmueble">
                            <a class="btn btn-info btn-sm" asp-action="Ver" asp-route-id="@item.IdInmueble"
                               title="Ver inmueble">
                                <i class="fa-solid fa-eye" aria-hidden="true"></i><span>Ver</span>
                            </a>
                            <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@item.IdInmueble"
                               title="Editar inmueble">
                                <i class="fa-solid fa-pen" aria-hidden="true"></i><span>Editar</span>
                            </a>
                            <a class="btn btn-secondary" asp-action="PorPropietario" asp-controller="Inmueble"
                               asp-route-id="@item.IdPropietario" title="Ver otros inmuebles del propietario">
                                <i class="fa-solid fa-building" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>

        <!-- Paginación -->
        <nav aria-label="Page navigation">
            <ul class="pagination">
                @if (Pagina > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="SinReservas" asp-route-dias="@dias" asp-route-pagina="@(Pagina - 1)"
                           aria-label="Anterior">
                            <i class="fa-solid fa-angles-left"></i>
                        </a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link"><i class="fa-solid fa-angles-left"></i></span>
                    </li>
                }

                @for (int i = 1; i <= TotalPaginas; i++)
                {
                    <li class="page-item @(i == Pagina ? "active" : "")">
                        <a class="page-link" asp-action="SinReservas" asp-route-dias="@dias" asp-route-pagina="@i">@i</a>
                    </li>
                }

                @if (Pagina < TotalPaginas)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="SinReservas" asp-route-dias="@dias" asp-route-pagina="@(Pagina + 1)"
                           aria-label="Siguiente">
                            <i class="fa-solid fa-angles-right"></i>
                        </a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link"><i class="fa-solid fa-angles-right"></i></span>
                    </li>
                }
            </ul>
        </nav>
    }
</section>