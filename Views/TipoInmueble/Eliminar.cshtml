@model Cuello_Inmobiliaria_LAB2.Models.TipoInmueble

@{
    ViewData["Title"] = "Eliminar Tipo";
}

<section class="delete-page">
    <div class="delete-card type-delete-card">
        <header class="delete-card-header">
            <div class="delete-icon" aria-hidden="true"><i class="fa-solid fa-tag"></i></div>
            <div>
                <p class="delete-eyebrow">Accion irreversible</p>
                <h1>Eliminar tipo de inmueble</h1>
                <p class="delete-question">¿Seguro que desea eliminar esta categoría?</p>
            </div>
        </header>
        <div class="delete-details">
            <h2>Datos de la categoría</h2>
            <dl>
                <div class="delete-detail">
                    <dt>@Html.DisplayNameFor(m => m.IdTipo)</dt>
                    <dd>@Html.DisplayFor(m => m.IdTipo)</dd>
                </div>
                <div class="delete-detail">
                    <dt>@Html.DisplayNameFor(m => m.Nombre)</dt>
                    <dd>@Html.DisplayFor(m => m.Nombre)</dd>
                </div>
            </dl>
        </div>
        <form asp-action="Eliminar" asp-route-id="@Model.IdTipo" class="delete-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                Eliminar tipo</button>
            </form>
        </div>
    </section>