@model Cuello_Inmobiliaria_LAB2.Models.TipoInmueble

@{
    ViewData["Title"] = "Crear Tipo de Inmueble";
}

<section class="edit-page">
    <div class="edit-card type-card">
        <header class="edit-card-header">
            <div class="edit-icon" aria-hidden="true"><i class="fa-solid fa-tags"></i></div>
            <div>
                <p class="edit-eyebrow">Catalogo de inmuebles</p>
                <h1>Nuevo tipo de inmueble</h1>
                <p class="edit-description">Agregue una categoría para clasificar las propiedades.</p>
            </div>
        </header>

        <form asp-action="Create" class="edit-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="edit-fields type-fields">
                <div class="form-group type-name-field">
                    <label asp-for="Nombre" class="control-label"></label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej.: Casa, Departamento, Local" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
            </div>
            <div class="edit-actions">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-success"><i class="fa-solid fa-plus" aria-hidden="true"></i> Crear
                    tipo</button>
                </div>
            </form>
        </div>
    </section>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }