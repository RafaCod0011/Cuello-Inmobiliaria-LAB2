@model Cuello_Inmobiliaria_LAB2.Models.Propietario

@{
    ViewData["Title"] = "Eliminar";
}

<section class="delete-page">
    <div class="delete-card">
        <header class="delete-card-header">
            <div class="delete-icon" aria-hidden="true">
                <i class="fa-solid fa-user-xmark"></i>
            </div>
            <div>
                <p class="delete-eyebrow">Accion irreversible</p>
                <h1>Eliminar propietario</h1>
                <p class="delete-question">¿Seguro que desea eliminar este propietario?</p>
            </div>
        </header>

        <div class="delete-details">
            <h2>Datos del propietario</h2>
            <dl>
                <div class="delete-detail">
                    <dt>@Html.DisplayNameFor(model => model.IdPropietario)</dt>
                    <dd>@Html.DisplayFor(model => model.IdPropietario)</dd>
                </div>
                <div class="delete-detail">
                    <dt>@Html.DisplayNameFor(model => model.Nombre)</dt>
                    <dd>@Html.DisplayFor(model => model.Nombre)</dd>
                </div>
                <div class="delete-detail">
                    <dt>@Html.DisplayNameFor(model => model.Apellido)</dt>
                    <dd>@Html.DisplayFor(model => model.Apellido)</dd>
                </div>
                <div class="delete-detail">
                    <dt>@Html.DisplayNameFor(model => model.Dni)</dt>
                    <dd>@Html.DisplayFor(model => model.Dni)</dd>
                </div>
                <div class="delete-detail">
                    <dt>@Html.DisplayNameFor(model => model.Telefono)</dt>
                    <dd>@Html.DisplayFor(model => model.Telefono)</dd>
                </div>
                <div class="delete-detail">
                    <dt>@Html.DisplayNameFor(model => model.Email)</dt>
                    <dd>@Html.DisplayFor(model => model.Email)</dd>
                </div>
            </dl>
        </div>

        <form asp-action="Eliminar" class="delete-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-danger">
                <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                Eliminar propietario
            </button>
        </form>
    </div>
</section>